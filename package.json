{
  "name": "seymour-mowing-ordering-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:staging": "cross-env CLOUDFLARE_ENV=staging react-router dev",
    "dev:production": "cross-env CLOUDFLARE_ENV=production react-router dev",
    "build": "react-router build",
    "build:staging": "cross-env CLOUDFLARE_ENV=staging react-router build",
    "build:production": "cross-env CLOUDFLARE_ENV=production react-router build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "cross-env CLOUDFLARE_ENV= wrangler d1 execute DB --config wrangler.jsonc --local --file drizzle/seeds/local.sql",
    "validate:access": "tsx .github/scripts/validate-deploy-config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/vitest-plugin": "^1.1.7",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@react-router/dev": "^8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
