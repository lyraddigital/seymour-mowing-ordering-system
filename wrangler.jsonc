{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seymour-local",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "vars": {
    "APP_ENV": "local",
    "DEV_AUTH_EMAIL": "developer@example.test",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seymour-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
      "migrations_pattern": "drizzle/migrations/*/migration.sql",
    },
  ],
  "env": {
    "staging": {
      "name": "seymour-staging-mowing-ordering-system",
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_TEAM_DOMAIN": "https://seymour-mm.cloudflareaccess.com",
        "ACCESS_AUD": "0979e22cd7474a22076b8eed736ca4976eeceab37b1862f0eff72471a256ff30",
        "DEV_AUTH_EMAIL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "seymour-staging",
          "database_id": "658f6569-13e9-416d-b4fc-0954ab733949",
          "migrations_dir": "drizzle/migrations",
          "migrations_pattern": "drizzle/migrations/*/migration.sql",
        },
      ],
    },
    "production": {
      "name": "seymour-mowing-ordering-system",
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TEAM_DOMAIN": "https://seymour-mm.cloudflareaccess.com",
        "ACCESS_AUD": "f133f32b16da137116556471c13010a23b8a4426b7e8c235b6d85f23c7577c55",
        "DEV_AUTH_EMAIL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "seymour-production",
          "database_id": "5d412c21-9a36-46e8-a15a-fc797975ff81",
          "migrations_dir": "drizzle/migrations",
          "migrations_pattern": "drizzle/migrations/*/migration.sql",
        },
      ],
    },
  },
}
